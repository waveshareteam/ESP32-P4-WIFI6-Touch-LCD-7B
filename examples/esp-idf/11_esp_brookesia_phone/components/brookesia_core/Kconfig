menu "ESP Brookesia - Core Configurations"
    # This product integration intentionally omits the legacy release/v0.6 AI
    # dependency stack. Keep the symbol for source compatibility, but do not
    # expose a menu option that cannot be resolved by this repository.
    config ESP_BROOKESIA_ENABLE_AI_FRAMEWORK
        bool
        default n

    menuconfig ESP_BROOKESIA_ENABLE_GUI
        bool "GUI"
        default y

    if ESP_BROOKESIA_ENABLE_GUI
        rsource "gui/Kconfig"
    endif

    menuconfig ESP_BROOKESIA_ENABLE_SERVICES
        bool "Services"
        default y

    if ESP_BROOKESIA_ENABLE_SERVICES
        rsource "services/Kconfig"
    endif

    menuconfig ESP_BROOKESIA_ENABLE_SYSTEMS
        bool "Systems"
        default y

    if ESP_BROOKESIA_ENABLE_SYSTEMS
        rsource "systems/Kconfig"
    endif
endmenu
